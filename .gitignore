# Icon build artifacts — regenerate via `python3 app/icon/generate_icon.py`
# (icon.svg.tmpl is the checked-in source; icon.svg and the .iconset are
# derived output). app/MacCleaner.icns itself IS checked in — build.sh
# copies it into the bundle without needing the generator to run.
app/icon/icon.svg
app/icon/MacCleaner.iconset/

# completions/run_tests.sh's zsh capture harness auto-creates this on every
# run (empty); it's a runtime artifact of the test zdot, not source.
completions/zdot/.zsh_history

# compinit's dump file, regenerated by the same capture harness on every run.
completions/zdot/.zcompdump
